generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListType {
  watchlist
  watching
  watched
  custom
}

enum MediaType {
  movie
  tv
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  sessionVersion Int    @default(0) @map("session_version")
  createdAt    DateTime @default(now()) @map("created_at")
  lists        List[]
  ratings      Rating[]
  favorites    Favorite[]
  progress     ViewingProgress[]
  watchEvents  WatchEvent[]
  resetTokens  PasswordResetToken[]

  @@map("users")
}

model List {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      ListType
  createdAt DateTime   @default(now()) @map("created_at")
  items     ListItem[]

  @@index([userId])
  @@map("lists")
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String   @map("list_id")
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  tmdbId    Int      @map("tmdb_id")
  mediaType MediaType @map("media_type")
  addedAt   DateTime @default(now()) @map("added_at")

  @@unique([listId, tmdbId, mediaType])
  @@map("list_items")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int      @map("tmdb_id")
  mediaType MediaType @map("media_type")
  score     Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, tmdbId, mediaType])
  @@map("ratings")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int      @map("tmdb_id")
  mediaType MediaType @map("media_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, tmdbId, mediaType])
  @@map("favorites")
}

model ViewingProgress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int      @map("tmdb_id")
  mediaType MediaType @map("media_type")
  season    Int
  episode   Int
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, tmdbId, mediaType])
  @@map("viewing_progress")
}

model WatchEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int      @map("tmdb_id")
  mediaType MediaType @map("media_type")
  score     Int?
  note      String?
  watchedAt DateTime @default(now()) @map("watched_at")

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, watchedAt])
  @@map("watch_events")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
